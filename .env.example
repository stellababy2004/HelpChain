# Core application
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Database
DATABASE_URL=sqlite:///instance/hc_local_dev.db

# Mail
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_SSL=false
MAIL_USE_TLS=true
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_DEFAULT_SENDER=contact@example.com
PRO_LEADS_NOTIFY_TO=contact@helpchain.live

# Administrator/bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NOTIFY_EMAIL=admin@example.com

# Push notifications
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# Public/proxy
PUBLIC_BASE_URL=https://helpchain.live
TRUST_PROXY_HEADERS=true
# PROXY_FIX_X_FOR=1
# PROXY_FIX_X_PROTO=1
# PROXY_FIX_X_HOST=1

# Metrics/security diagnostics
METRICS_TOKEN=replace-with-long-random-token
HC_ENABLE_LEAK_TEST=0
# Comma-separated; optional. Example: 203.0.113.10,198.51.100.22
HC_LEAK_TEST_ALLOWLIST=
