msgid "Repères de réassurance"
msgstr "Ориентири за сигурност"

#: deploiement.html:221
msgid "France-first"
msgstr "Фокус върху Франция"

#: deploiement.html:223
msgid "Sans migration lourde"
msgstr "Без тежка миграция"

